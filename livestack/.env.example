# livestack settings. Copy to .env (git-ignored) and fill in.
#   copy .env.example .env        (Windows)     cp .env.example .env   (bash)
# Keep values on their own line (no trailing comments). Never commit .env.

# =========================================================== CONTROL MACHINE ONLY
# (these are never copied to the server)

# Vultr: Account -> API. Restrict the key to your PC's IP in Vultr's API settings.
VULTR_API_KEY=
# Mumbai=bom, Bangalore=blr, Delhi=del
VULTR_REGION=bom
# 4 vCPU plan id - confirm availability/price: GET https://api.vultr.com/v2/plans?type=vc2 (VERIFY)
VULTR_PLAN=vc2-4c-8gb
# From `livestack.py snapshot` (docs/SETUP.md step 6)
VULTR_SNAPSHOT_ID=
# Reserved IP id (Network -> Reserved IPs), same region as VULTR_REGION
VULTR_RESERVED_IP_ID=
# Optional: comma-separated Vultr SSH key ids, Vultr firewall group id
VULTR_SSH_KEY_IDS=
VULTR_FIREWALL_GROUP_ID=

SSH_USER=root
SSH_KEY_PATH=~/.ssh/livestack_ed25519

# `orphans` alerts on livestack servers older than this
MAX_SESSION_HOURS=4

# CDN hostname viewers use (CNAME to BlazingCDN)
LIVE_HOST=live.example.com

# Replay bucket - write credentials (R2 -> Manage API tokens -> Object Read & Write, this bucket only)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=lms-replays
# Optional: only for an EU-jurisdiction bucket (https://<ID>.eu.r2.cloudflarestorage.com) or a local emulator.
# Leave empty for normal buckets. Check both tokens with: python control\replay.py selftest [--state]
R2_ENDPOINT_URL=

# Optional: full path to ffmpeg if it is not on PATH (forward slashes are fine on Windows)
FFMPEG_BIN=C:/Users/S Sreedhar Goud/ffmpeg-9.0.2-essentials_build/bin/ffmpeg.exe

# =========================================================== COPIED TO THE SERVER
# (written to /etc/livestack/env by `livestack.py start`)

ORIGIN_HOST=origin.example.com
INGEST_HOST=ingest.example.com

# OBS stream key becomes:  <name>?user=PUBLISH_USER&pass=PUBLISH_PASS
PUBLISH_USER=streamer
# 16+ chars of A-Z a-z 0-9 _ -   Generate: python -c "import secrets;print(secrets.token_urlsafe(24))"
PUBLISH_PASS=

# Who may connect to RTMP 1935: comma-separated IPs/CIDRs, or "any" (publish auth still applies).
# Home ISPs often change your IP - see docs/RUNBOOK.md "Streamer cannot connect".
STREAMER_IPS=
# Optional: restrict SSH to these IPs/CIDRs (default: any, key-only)
ADMIN_IPS=

# TLS for ORIGIN_HOST (docs/SETUP.md step 4)
ACME_EMAIL=
# Cloudflare API token with Zone:DNS:Edit on your zone only (for certbot DNS-01)
CF_DNS_API_TOKEN=

# Private R2 bucket for server state (TLS cert backup). Separate token, scoped to this bucket only.
STATE_BUCKET=livestack-state
STATE_R2_ACCOUNT_ID=
STATE_R2_ACCESS_KEY_ID=
STATE_R2_SECRET_ACCESS_KEY=

# Alerts: Discord/Slack incoming-webhook URL or an ntfy topic URL (https://ntfy.sh/<random-topic>)
ALERT_WEBHOOK_URL=

# Optional: git repo the server pulls config from at boot (falls back to the snapshot's copy)
CONFIG_REPO_URL=
CONFIG_REPO_REF=main

# Server-side safety-net recording of the incoming stream (yes/no)
RECORD_BACKUP=yes
# Set to "no" if Vultr already configures the reserved IP on the interface (VERIFY)
CONFIGURE_RESERVED_IP=auto
